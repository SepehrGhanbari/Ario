.table-wrap{max-width:100%;overflow-x:auto;margin:20px 0 30px}table{border-collapse:collapse;width:100%;font-size:14px;line-height:1.95;table-layout:fixed}td,th{border:1px solid var(--line);padding:11px 12px;vertical-align:top;text-align:start;overflow-wrap:anywhere}th{background:#edf5f5}tr:nth-child(even){background:#fafcfc}.code{direction:ltr;unicode-bidi:isolate;font-family:Consolas,monospace;font-size:.88em;overflow-wrap:anywhere}.quote{padding:12px 18px;background:#f7f9f9;border-inline-start:3px solid #98b9bd}footer{font-size:13px;color:var(--muted);margin-top:40px}a:focus{outline:2px solid #155f68}
