    mark=("ario.offline.test","REQ-0",enrollment(0).key_id,"SYNTHETIC-01")
    r=run(marks=w4c.ReplayView((mark,)))
    assert r.status=="REJECTED" and r.reason=="W4C_REPLAY_IN_INJECTED_VIEW"
    fail_closed(r)


